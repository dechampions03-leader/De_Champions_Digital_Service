<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#160B27">
<meta name="description" content="DCDS Independent Announcement Management">
<title>DCDS Announcement Manager</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>


/* =====================================
   DCDS BRAND COLOR SYSTEM
====================================== */

:root {

    --primary-purple: #6C2BD9;

    --deep-purple: #2B124C;

    --dark-background: #160B27;

    --darker-background: #0D0717;

    --luxury-gold: #D4AF37;

    --bright-gold: #F5D77A;

    --pure-white: #FFFFFF;

    --soft-white: #F3EDF9;

    --muted-text: #B8A9CC;

    --success-green: #25C47A;

    --danger-red: #F05252;

    --card-background: rgba(255,255,255,0.055);

    --border-color: rgba(212,175,55,0.25);

}


/* =====================================
   GLOBAL RESET
====================================== */

* {

    margin: 0;

    padding: 0;

    box-sizing: border-box;

}


/* =====================================
   MAIN BODY DESIGN
====================================== */

body {

    font-family: 'Segoe UI', Arial, sans-serif;

    background:
        radial-gradient(
            circle at top left,
            rgba(108,43,217,0.20),
            transparent 35%
        ),
        linear-gradient(
            135deg,
            var(--darker-background),
            var(--deep-purple),
            var(--dark-background)
        );

    color: var(--pure-white);

    min-height: 100vh;

    padding: 25px 18px;

    line-height: 1.6;

}


/* =====================================
   MAIN APPLICATION CONTAINER
====================================== */

#adminApp {

    width: 100%;

    max-width: 1150px;

    margin: 0 auto;

}/* =====================================
   HEADER DESIGN
====================================== */

#adminHeader {

    display: flex;

    justify-content: space-between;

    align-items: center;

    flex-wrap: wrap;

    gap: 20px;

    padding: 25px 28px;

    margin-bottom: 35px;

    border: 1px solid var(--border-color);

    border-radius: 20px;

    background: linear-gradient(
        135deg,
        rgba(255,255,255,0.09),
        rgba(255,255,255,0.025)
    );

    box-shadow:
        0 12px 35px rgba(0,0,0,0.25),
        inset 0 1px 0 rgba(255,255,255,0.05);

    backdrop-filter: blur(15px);

}


/* =====================================
   BRAND NAME
====================================== */

.brand-section h1 {

    font-size: 25px;

    font-weight: 900;

    letter-spacing: 1.5px;

    color: var(--bright-gold);

    line-height: 1.3;

}


.brand-section h1 span {

    display: block;

    color: var(--pure-white);

    font-size: 17px;

    letter-spacing: 3px;

    margin-top: 3px;

}


.brand-section p {

    color: var(--muted-text);

    font-size: 11px;

    letter-spacing: 3px;

    margin-top: 10px;

    font-weight: 700;

}


/* =====================================
   LOGOUT BUTTON
====================================== */

#logoutButton {

    background: linear-gradient(
        135deg,
        #D94A4A,
        #A91E35
    );

    color: white;

    border: none;

    padding: 12px 23px;

    border-radius: 10px;

    font-weight: 800;

    letter-spacing: 1px;

    cursor: pointer;

    transition: 0.3s ease;

}


#logoutButton:hover {

    transform: translateY(-3px);

    box-shadow: 0 7px 20px rgba(217,74,74,0.3);

}


/* =====================================
   WELCOME SECTION
====================================== */

#welcomeSection {

    margin-bottom: 30px;

    padding: 15px 5px;

}


#welcomeSection h2 {

    font-size: 29px;

    font-weight: 800;

    color: var(--bright-gold);

    margin-bottom: 8px;

}


#welcomeSection p {

    max-width: 750px;

    color: var(--muted-text);

    font-size: 15px;

    line-height: 1.8;

}  /* =====================================
   DASHBOARD STATISTICS
====================================== */

#statisticsSection {

    display: grid;

    grid-template-columns: repeat(
        auto-fit,
        minmax(200px, 1fr)
    );

    gap: 18px;

    margin-bottom: 35px;

}


.stat-card {

    position: relative;

    overflow: hidden;

    padding: 25px;

    border-radius: 17px;

    background: linear-gradient(
        145deg,
        rgba(255,255,255,0.09),
        rgba(255,255,255,0.025)
    );

    border: 1px solid var(--border-color);

    box-shadow: 0 10px 25px rgba(0,0,0,0.2);

    transition: 0.3s ease;

}


.stat-card:hover {

    transform: translateY(-5px);

    border-color: var(--luxury-gold);

}


.stat-card p {

    color: var(--muted-text);

    font-size: 13px;

    font-weight: 600;

    margin-bottom: 12px;

}


.stat-card h3 {

    color: var(--bright-gold);

    font-size: 28px;

    font-weight: 900;

    letter-spacing: 1px;

}


/* =====================================
   MAIN CONTENT PANELS
====================================== */

#createAnnouncementSection,
#historySection {

    padding: 30px;

    margin-bottom: 28px;

    border-radius: 20px;

    background: linear-gradient(
        145deg,
        rgba(255,255,255,0.075),
        rgba(255,255,255,0.025)
    );

    border: 1px solid var(--border-color);

    box-shadow: 0 12px 35px rgba(0,0,0,0.2);

}


/* =====================================
   SECTION HEADINGS
====================================== */

.section-heading {

    margin-bottom: 27px;

    padding-bottom: 17px;

    border-bottom: 1px solid var(--border-color);

}


.section-heading h2 {

    color: var(--bright-gold);

    font-size: 22px;

    font-weight: 800;

    margin-bottom: 7px;

}


.section-heading p {

    color: var(--muted-text);

    font-size: 13px;

}/* =====================================
   FORM GROUPS
====================================== */

.form-group {

    margin-bottom: 23px;

}


.form-group > label {

    display: block;

    color: var(--soft-white);

    font-size: 14px;

    font-weight: 700;

    margin-bottom: 10px;

}


/* =====================================
   INPUT FIELDS
====================================== */

input[type="text"],
textarea,
select {

    display: block;

    width: 100%;

    padding: 15px 16px;

    border: 1px solid rgba(212,175,55,0.28);

    border-radius: 11px;

    background: rgba(13,7,23,0.75);

    color: var(--pure-white);

    font-family: inherit;

    font-size: 14px;

    outline: none;

    transition: 0.3s ease;

}


input[type="text"]::placeholder,
textarea::placeholder {

    color: #9888AB;

}


input[type="text"]:focus,
textarea:focus,
select:focus {

    border-color: var(--bright-gold);

    box-shadow: 0 0 0 3px rgba(212,175,55,0.12);

}


textarea {

    min-height: 155px;

    resize: vertical;

    line-height: 1.7;

}


select {

    cursor: pointer;

}


select option {

    background: var(--deep-purple);

    color: white;

}


/* =====================================
   AUDIENCE SELECTION CARDS
====================================== */

#audienceOptions {

    display: grid;

    grid-template-columns: repeat(
        auto-fit,
        minmax(210px, 1fr)
    );

    gap: 13px;

}


#audienceOptions label {

    display: flex;

    align-items: center;

    gap: 11px;

    padding: 17px;

    min-height: 58px;

    border: 1px solid var(--border-color);

    border-radius: 12px;

    background: rgba(255,255,255,0.035);

    color: var(--soft-white);

    font-size: 13px;

    font-weight: 600;

    cursor: pointer;

    transition: 0.3s ease;

}


#audienceOptions label:hover {

    background: rgba(108,43,217,0.2);

    border-color: var(--bright-gold);

}


#audienceOptions input[type="radio"] {

    width: 17px;

    height: 17px;

    accent-color: var(--luxury-gold);

    cursor: pointer;

}


/* =====================================
   COURSE SELECTION AREA
====================================== */

#courseSelection {

    padding: 18px;

    border-radius: 12px;

    background: rgba(108,43,217,0.12);

    border: 1px solid var(--border-color);

    margin-top: 15px;

}


#courseSelection[hidden] {

    display: none;

}/* =====================================
   PUBLISH ANNOUNCEMENT BUTTON
====================================== */

#publishButton {

    display: block;

    width: 100%;

    padding: 17px;

    border: none;

    border-radius: 12px;

    background: linear-gradient(
        110deg,
        #B88A16,
        #F5D77A,
        #D4AF37
    );

    color: #241438;

    font-size: 14px;

    font-weight: 900;

    letter-spacing: 1.3px;

    cursor: pointer;

    transition: 0.3s ease;

    box-shadow: 0 7px 20px rgba(212,175,55,0.15);

}


#publishButton:hover {

    transform: translateY(-3px);

    box-shadow: 0 10px 25px rgba(212,175,55,0.3);

}


#publishButton:disabled {

    opacity: 0.6;

    cursor: not-allowed;

    transform: none;

}


/* =====================================
   STATUS MESSAGE
====================================== */

#statusMessage {

    display: none;

    padding: 14px 16px;

    margin-top: 17px;

    border-radius: 10px;

    font-size: 13px;

    line-height: 1.6;

}


#statusMessage.success {

    display: block;

    color: #83F0B6;

    background: rgba(37,196,122,0.12);

    border: 1px solid rgba(37,196,122,0.25);

}


#statusMessage.error {

    display: block;

    color: #FF9A9D;

    background: rgba(240,82,82,0.12);

    border: 1px solid rgba(240,82,82,0.25);

}


/* =====================================
   ANNOUNCEMENT HISTORY CARDS
====================================== */

#announcementHistory {

    display: flex;

    flex-direction: column;

    gap: 15px;

}


.announcement-card {

    padding: 20px;

    border-radius: 13px;

    background: rgba(255,255,255,0.035);

    border: 1px solid rgba(212,175,55,0.2);

}


.announcement-card h3 {

    color: var(--bright-gold);

    font-size: 17px;

    margin-bottom: 9px;

}


.announcement-card p {

    color: var(--soft-white);

    font-size: 14px;

    line-height: 1.8;

    white-space: pre-wrap;

}


.announcement-card small {

    display: block;

    color: var(--muted-text);

    font-size: 12px;

    margin-top: 13px;

}


/* =====================================
   FOOTER
====================================== */

#adminFooter {

    text-align: center;

    padding: 25px 10px;

    color: var(--muted-text);

    font-size: 12px;

    line-height: 2;

    border-top: 1px solid var(--border-color);

}


#adminFooter p:last-child {

    color: var(--bright-gold);

    font-weight: 800;

    letter-spacing: 2px;

}  /* =====================================
   BLOCK 4: RESPONSIVE DESIGN
====================================== */


/* =====================================
   TABLET RESPONSIVENESS
====================================== */

@media screen and (max-width: 900px) {

    #adminApp {
        max-width: 100%;
    }

    #adminHeader {
        padding: 22px;
    }

    #welcomeSection h2 {
        font-size: 25px;
    }

    #createAnnouncementSection,
    #historySection {
        padding: 24px;
    }

}


/* =====================================
   MOBILE RESPONSIVENESS
====================================== */

@media screen and (max-width: 600px) {

    body {
        padding: 13px 10px;
    }

    #adminHeader {
        padding: 18px;
        border-radius: 15px;
        margin-bottom: 25px;
    }

    .brand-section h1 {
        font-size: 21px;
    }

    .brand-section h1 span {
        font-size: 14px;
        letter-spacing: 2px;
    }

    .brand-section p {
        font-size: 9px;
        letter-spacing: 2px;
    }

    #logoutButton {
        padding: 10px 17px;
        font-size: 12px;
    }

    #welcomeSection {
        padding: 10px 3px;
        margin-bottom: 22px;
    }

    #welcomeSection h2 {
        font-size: 22px;
    }

    #welcomeSection p {
        font-size: 13px;
    }

    #statisticsSection {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 23px;
    }

    .stat-card {
        padding: 17px 13px;
        border-radius: 13px;
    }

    .stat-card p {
        font-size: 11px;
    }

    .stat-card h3 {
        font-size: 21px;
    }

    #createAnnouncementSection,
    #historySection {
        padding: 18px 15px;
        border-radius: 15px;
        margin-bottom: 20px;
    }

    .section-heading h2 {
        font-size: 19px;
    }

    .section-heading p {
        font-size: 12px;
    }

    input[type="text"],
    textarea,
    select {
        padding: 13px;
        font-size: 13px;
    }

    textarea {
        min-height: 130px;
    }

    #audienceOptions {
        grid-template-columns: 1fr;
        gap: 9px;
    }

    #audienceOptions label {
        padding: 14px;
        font-size: 12px;
    }

    #publishButton {
        padding: 15px 10px;
        font-size: 12px;
    }

    .announcement-card {
        padding: 16px;
    }

    .announcement-card h3 {
        font-size: 15px;
    }

    .announcement-card p {
        font-size: 13px;
    }

    #adminFooter {
        font-size: 11px;
        padding: 20px 5px;
    }

}/* =====================================
   EXTRA SMALL PHONE SCREENS
====================================== */

@media screen and (max-width: 360px) {

    #statisticsSection {
        grid-template-columns: 1fr;
    }

    .brand-section h1 {
        font-size: 19px;
    }

    #welcomeSection h2 {
        font-size: 20px;
    }

}


/* =====================================
   SMOOTH PAGE APPEARANCE
====================================== */

html {
    scroll-behavior: smooth;
}


/* =====================================
   CUSTOM SCROLLBAR
====================================== */

::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: var(--darker-background);
}

::-webkit-scrollbar-thumb {
    background: var(--primary-purple);
    border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--luxury-gold);
}


/* =====================================
   BUTTON FOCUS ACCESSIBILITY
====================================== */

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
    outline: 2px solid var(--bright-gold);
    outline-offset: 3px;
}


/* =====================================
   ANIMATION FINISHING TOUCH
====================================== */

.stat-card,
.announcement-card,
#createAnnouncementSection,
#historySection {
    animation: fadeInUp 0.6s ease both;
}

@keyframes fadeInUp {

    from {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}


/* =====================================
   END OF CSS DESIGN
====================================== *//* ADMIN ACCESS VISIBILITY */

[hidden] {
    display: none !important;
}

#adminApp {
    opacity: 0;
    transition: opacity 0.3s ease;
}

#adminApp.admin-authorized {
    opacity: 1;
}

/* Announcement page additions — isolated from notification-center styles */
#adminHeader, #welcomeSection, #statisticsSection, #mainContent {max-width:1100px;margin:0 auto 24px}
#adminHeader{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.brand-section h1{font-size:clamp(20px,4vw,29px);letter-spacing:1px;color:#fff}.brand-section h1 span{display:block;color:#F5D77A;font-size:.58em;letter-spacing:3px}.brand-section p{color:#B8A9CC;font-size:12px;letter-spacing:2px;margin-top:8px}
#logoutButton,.action-button{border:1px solid rgba(212,175,55,.45);border-radius:10px;padding:12px 18px;background:linear-gradient(135deg,#6C2BD9,#2B124C);color:#fff;font-weight:700;cursor:pointer}
#welcomeSection,.panel,.stat-card{background:rgba(255,255,255,.055);border:1px solid rgba(212,175,55,.25);border-radius:18px;padding:24px;box-shadow:0 12px 35px rgba(0,0,0,.2)}
#welcomeSection h2{color:#F5D77A;margin-bottom:8px}#welcomeSection p,.muted{color:#B8A9CC}
#statisticsSection{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}.stat-card p{color:#B8A9CC;font-size:13px}.stat-card h3{font-size:25px;color:#F5D77A;margin-top:7px}
#mainContent{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:20px}.panel h2{color:#F5D77A;font-size:20px;margin-bottom:8px}.panel .intro{color:#B8A9CC;font-size:13px;margin-bottom:22px}
.form-group{margin-bottom:18px}.form-group label{display:block;color:#F3EDF9;font-size:14px;font-weight:700;margin-bottom:8px}
input[type=text],textarea,select{width:100%;padding:14px;border:1px solid rgba(212,175,55,.28);border-radius:10px;background:#130a20;color:#fff;font:inherit}textarea{min-height:150px;resize:vertical}input:focus,textarea:focus,select:focus{outline:2px solid rgba(212,175,55,.35);border-color:#F5D77A}
.audience-note{padding:14px;border:1px dashed rgba(212,175,55,.35);border-radius:10px;color:#B8A9CC;font-size:13px;line-height:1.6}
.status{display:none;margin-top:14px;padding:12px;border-radius:9px;background:rgba(212,175,55,.1);color:#F5D77A;font-size:13px}
.preview-card{border:1px solid rgba(212,175,55,.25);border-radius:13px;padding:16px;background:rgba(255,255,255,.035);margin-top:15px}.preview-card h3{color:#fff;margin-bottom:7px}.preview-card p{color:#B8A9CC;white-space:pre-wrap;overflow-wrap:anywhere}
.history-empty{border:1px dashed rgba(212,175,55,.3);border-radius:12px;padding:20px;color:#B8A9CC;font-size:13px;line-height:1.6}
.top-links{display:flex;gap:10px;flex-wrap:wrap;margin:0 auto 20px;max-width:1100px}.top-links a{color:#F5D77A;text-decoration:none;border:1px solid rgba(212,175,55,.25);padding:9px 12px;border-radius:9px;font-size:13px}
#adminApp[hidden]{display:none!important}
@media(max-width:760px){body{padding:18px 12px}#mainContent{grid-template-columns:1fr}.panel{padding:18px}}
</style></head>
<body>
<div id="adminApp" hidden>
<header id="adminHeader">
 <div class="brand-section"><h1>DE CHAMPIONS <span>DIGITAL SERVICE</span></h1><p>INDEPENDENT ANNOUNCEMENT MANAGER</p></div>
 <button id="logoutButton" type="button" onclick="logoutAdmin()">LOG OUT</button>
</header>
<nav class="top-links" aria-label="Admin sections"><a href="admin-notifications.html">Notification Center</a><a href="admin-announcements.html" aria-current="page">Announcement Manager</a></nav>
<section id="welcomeSection"><h2>Welcome back, Administrator 👑</h2><p>Manage student-facing announcements independently from the DCDS notification center.</p></section>
<section id="statisticsSection">
 <div class="stat-card"><p>Announcement records</p><h3>—</h3></div>
 <div class="stat-card"><p>Publishing status</p><h3>NOT CONNECTED</h3></div>
 <div class="stat-card"><p>Notification system</p><h3>SEPARATE</h3></div>
</section>
<main id="mainContent">
 <section class="panel">
  <h2>Create an announcement</h2><p class="intro">Prepare the announcement content and audience. Publishing will be enabled after the independent Supabase backend is connected.</p>
  <form id="announcementForm">
   <div class="form-group"><label for="announcementTitle">Announcement title</label><input id="announcementTitle" type="text" maxlength="150" placeholder="e.g. Important class update" required></div>
   <div class="form-group"><label for="announcementMessage">Announcement message</label><textarea id="announcementMessage" maxlength="5000" placeholder="Write the full announcement here..." required></textarea></div>
   <div class="form-group"><label for="announcementCategory">Category</label><select id="announcementCategory"><option value="general">General update</option><option value="important">Important notice</option><option value="course">Course update</option><option value="promotion">Promotion</option><option value="event">Event announcement</option></select></div>
   <div class="form-group"><label for="announcementAudience">Audience</label><select id="announcementAudience"><option value="all">All students</option><option value="enrolled">Enrolled students</option><option value="general_course">General course students</option><option value="specific_course">Specific course students</option></select></div>
   <div class="audience-note">Audience targeting is shown here for the frontend review. Course selection and recipient targeting will be connected to the independent announcement tables in the backend stage.</div>
   <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:20px"><button class="action-button" type="button" id="previewButton">Preview announcement</button><button class="action-button" type="submit" disabled title="Publishing will be enabled after Supabase is connected">Publish (backend pending)</button></div>
   <div id="statusMessage" class="status" role="status" aria-live="polite"></div>
  </form>
 </section>
 <aside class="panel"><h2>Announcement preview</h2><p class="intro">See how your announcement content will read before we connect publishing.</p><div class="preview-card"><h3 id="previewTitle">Your announcement title</h3><p id="previewMessage">Your announcement message will appear here.</p><p class="muted" id="previewMeta" style="font-size:12px;margin-top:14px">General update · All students</p></div><div style="height:22px"></div><h2>Announcement history</h2><p class="intro">Your independent announcement history will appear here after the backend is connected.</p><div class="history-empty">No announcement records are connected yet. This page is currently frontend-only; it does not read from or write to the existing notifications tables.</div></aside>
</main>
</div><script>
// Shared DCDS Supabase project configuration and administrator access check.
const SUPABASE_URL = "https://qxsenflgaweeadvggnyp.supabase.co";
const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_pjQHFevEKbynxM710gAHAA_a33-yeNP";
const db = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);
let currentAdmin = null;
async function getCurrentSession(){
 const {data:{session},error}=await db.auth.getSession();
 if(error) throw error;
 return session;
}
async function verifyAdminRole(){
 const {data,error}=await db.rpc("is_dcds_admin");
 if(error) throw error;
 return data === true;
}
async function initializeAdminCenter(){
 const app=document.getElementById("adminApp");
 app.hidden=true;
 try{
  const session=await getCurrentSession();
  if(!session){window.location.replace("index.html?login=required&next=admin-announcements.html");return;}
  currentAdmin=session.user;
  const isAdmin=await verifyAdminRole();
  if(!isAdmin){alert("ACCESS DENIED! Your account is not authorized to access the DCDS Admin Center.");await db.auth.signOut();window.location.replace("index.html");return;}
  app.hidden=false;
 }catch(error){console.error("Announcement admin authorization error:",error);alert("Unable to verify administrator access. Please try again.");window.location.replace("index.html");}
}
async function logoutAdmin(){
 if(!confirm("Are you sure you want to log out of the DCDS Admin Center?"))return;
 const {error}=await db.auth.signOut();
 if(error){alert("Unable to log out. Please try again.");return;}
 currentAdmin=null;window.location.href="index.html";
}
db.auth.onAuthStateChange((event,session)=>{
 if(event==="SIGNED_OUT"||!session)window.location.replace("index.html?login=required&next=admin-announcements.html");
});
const titleInput=document.getElementById("announcementTitle");
const messageInput=document.getElementById("announcementMessage");
const categoryInput=document.getElementById("announcementCategory");
const audienceInput=document.getElementById("announcementAudience");
function updatePreview(){
 document.getElementById("previewTitle").textContent=titleInput.value.trim()||"Your announcement title";
 document.getElementById("previewMessage").textContent=messageInput.value.trim()||"Your announcement message will appear here.";
 const category=categoryInput.options[categoryInput.selectedIndex].text;
 const audience=audienceInput.options[audienceInput.selectedIndex].text;
 document.getElementById("previewMeta").textContent=category+" · "+audience;
}
document.getElementById("previewButton").addEventListener("click",()=>{updatePreview();const box=document.getElementById("statusMessage");box.textContent="Preview updated. Publishing is not enabled until the separate announcement backend is connected.";box.style.display="block";});
[titleInput,messageInput,categoryInput,audienceInput].forEach(el=>el.addEventListener("input",updatePreview));
document.getElementById("announcementForm").addEventListener("submit",event=>{event.preventDefault();});
document.addEventListener("DOMContentLoaded",initializeAdminCenter);
</script>
</body>
</html>
